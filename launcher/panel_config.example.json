{
 "_note": "MetaMuse Stage launcher + panel manager settings (implementation-spec.md 6). Relative paths are relative to this file. game_mode: musestudio (MuseStudio on the original Studio, 2026-11-03) / native (the Godot app) / web.",
 "browser": "",
 "game_mode": "musestudio",
 "musestudio_exe": "../MuseStudio/game/CharaStudio.exe",
