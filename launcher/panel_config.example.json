 "muse_url": "https://muse.ai/",
 "profiles_dir": "profiles",
 "panel": {
  "width": 400,
  "height": 560,
  "side": "right",
  "margin": 0,
  "bottom_edge": "workarea"
 },
 "base_opacity": 200,
