 "hover_focus_leave_ms": 300,
 "hover_focus_cooldown_ms": 400,
 "quit_all": {
  "game": true,
  "bridge": true,
  "irodori": false,
  "panel": false
 },
 "_note_example": "Copy to panel_config.json and fill in this machine's paths (irodori.dir, irodori.env.HF_HOME; godot_exe only for game_mode native)."
