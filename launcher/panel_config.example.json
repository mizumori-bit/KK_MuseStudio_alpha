 "controls_attach": "bottom_outside",
 "hotkey_quit": "ctrl+alt+q",
 "irodori": {
  "health_url": "http://127.0.0.1:8088/health",
  "dir": "",
  "command": [
   "uv",
   "run",
   "--no-sync",
   "python",
   "-m",
   "irodori_openai_tts",
   "--host",
   "127.0.0.1",
   "--port",
   "8088"
  ],
  "env": {
   "HF_HOME": ""
  },
  "wait_seconds": 120
 },
